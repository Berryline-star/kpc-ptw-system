generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model User {
  id                    String               @id @default(cuid())
  name                  String
  email                 String               @unique
  passwordHash          String
  role                  Role
  department            String?
  phone                 String?
  avatarUrl             String?
  isActive              Boolean              @default(true)
  // Both plain integer/nullable-with-no-default columns, so — unlike
  // verificationToken's cuid() default — Prisma can add these directly
  // against existing rows in one step, no hand-authored backfill needed.
  failedLoginAttempts   Int                  @default(0)
  lockedUntil           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  activityEntries       ActivityEntry[]
  approvalSteps         ApprovalStep[]
  attachments           Attachment[]
  auditLogs             AuditLog[]
  notifications         Notification[]
  passwordResets        PasswordResetToken[]
  permitsCreated        Permit[]             @relation("PermitCreatedBy")
  permitsSupervising    Permit[]             @relation("PermitSupervisor")
  riskAssessmentsSigned RiskAssessment[]

  @@index([role])
}

// Backs checkRateLimit() in lib/rate-limit.ts. DB-backed rather than an
// in-memory Map: this app runs on serverless functions (Vercel), where
// each invocation can land on a different, memory-isolated instance —
// an in-memory counter would silently under-count and let far more
// requests through than intended.
model RateLimitEntry {
  key         String   @id
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

model RolePermission {
  id         String           @id @default(cuid())
  role       Role
  module     PermissionModule
  canView    Boolean          @default(false)
  canCreate  Boolean          @default(false)
  canApprove Boolean          @default(false)
  canDelete  Boolean          @default(false)

  @@unique([role, module])
}

model Permit {
  id                 String          @id @default(cuid())
  permitNumber       String          @unique
  // Deliberately separate from `id`: encoding the primary key in a
  // publicly-shared/printed QR code would let anyone who photographs a
  // permit probe or guess other permits' internal record IDs. This can
  // also be rotated independently if a printed permit is compromised.
  // The @default only applies to new rows going forward — existing rows
  // are backfilled explicitly in migrations/20260702120000_add_verification_token
  // (Prisma's default is evaluated client-side per insert, so it can't
  // auto-backfill a table that already has data).
  verificationToken  String          @unique @default(cuid())
  type               PermitType
  status             PermitStatus    @default(DRAFT)
  facilityName       String
  specificLocation   String
  gpsLat             Float?
  gpsLng             Float?
  workDescription    String
  startDate          DateTime
  endDate            DateTime
  requiredEquipment  String[]
  contractorName     String?
  contractorIdNumber String?
  department         String?
  riskLevel          RiskLevel?
  createdById        String
  supervisorId       String?
  submittedAt        DateTime?
  closedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  activityEntries    ActivityEntry[]
  approvalSteps      ApprovalStep[]
  attachments        Attachment[]
  notifications      Notification[]
  createdBy          User            @relation("PermitCreatedBy", fields: [createdById], references: [id])
  supervisor         User?           @relation("PermitSupervisor", fields: [supervisorId], references: [id])
  riskAssessment     RiskAssessment?

  @@index([status])
  @@index([type])
  @@index([createdById])
}

model RiskAssessment {
  id              String               @id @default(cuid())
  permitId        String               @unique
  overallScore    Int
  overallLevel    RiskLevel
  status          RiskAssessmentStatus @default(PENDING_REVIEW)
  requiredPPE     String[]
  signedById      String?
  signedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  controlMeasures ControlMeasure[]
  hazards         Hazard[]
  permit          Permit               @relation(fields: [permitId], references: [id], onDelete: Cascade)
  signedBy        User?                @relation(fields: [signedById], references: [id])
}

model Hazard {
  id               String         @id @default(cuid())
  riskAssessmentId String
  description      String
  category         String
  likelihood       Int
  severity         Int
  riskScore        Int
  riskLevel        RiskLevel
  createdAt        DateTime       @default(now())
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
}

model ControlMeasure {
  id               String               @id @default(cuid())
  riskAssessmentId String
  description      String
  status           ControlMeasureStatus @default(PENDING_DEPLOYMENT)
  createdAt        DateTime             @default(now())
  riskAssessment   RiskAssessment       @relation(fields: [riskAssessmentId], references: [id], onDelete: Cascade)
}

model ApprovalStep {
  id           String         @id @default(cuid())
  permitId     String
  sequence     Int
  requiredRole Role
  approverId   String?
  status       ApprovalStatus @default(PENDING)
  comments     String?
  signedAt     DateTime?
  createdAt    DateTime       @default(now())
  approver     User?          @relation(fields: [approverId], references: [id])
  permit       Permit         @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@unique([permitId, sequence])
}

model Attachment {
  id           String             @id @default(cuid())
  permitId     String
  fileName     String
  fileUrl      String
  fileSize     Int
  mimeType     String
  category     AttachmentCategory @default(OTHER)
  uploadedById String
  createdAt    DateTime           @default(now())
  permit       Permit             @relation(fields: [permitId], references: [id], onDelete: Cascade)
  uploadedBy   User               @relation(fields: [uploadedById], references: [id])
}

model ActivityEntry {
  id        String       @id @default(cuid())
  permitId  String
  authorId  String?
  type      ActivityType @default(COMMENT)
  message   String
  createdAt DateTime     @default(now())
  author    User?        @relation(fields: [authorId], references: [id])
  permit    Permit       @relation(fields: [permitId], references: [id], onDelete: Cascade)

  @@index([permitId])
}

model Notification {
  id              String           @id @default(cuid())
  userId          String
  type            NotificationType
  title           String
  message         String
  isRead          Boolean          @default(false)
  relatedPermitId String?
  createdAt       DateTime         @default(now())
  relatedPermit   Permit?          @relation(fields: [relatedPermitId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  actor      User?    @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum Role {
  SYSTEM_ADMIN
  SAFETY_OFFICER
  DEPOT_MANAGER
  CONTRACTOR
  SUPERVISOR
}

enum PermitType {
  HOT_WORK
  COLD_WORK
  CONFINED_SPACE
  EXCAVATION
  WORKING_AT_HEIGHT
  ELECTRICAL
}

enum PermitStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  EXPIRED
  CLOSED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum RiskAssessmentStatus {
  PENDING_REVIEW
  VERIFIED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ControlMeasureStatus {
  PENDING_DEPLOYMENT
  IMPLEMENTED
}

enum AttachmentCategory {
  WORK_PLAN_JHA
  SITE_PHOTO
  OTHER
}

enum ActivityType {
  COMMENT
  SYSTEM_UPDATE
  STATUS_CHANGE
}

enum NotificationType {
  URGENT
  SAFETY_ALERT
  APPROVAL_REQUEST
  SYSTEM_UPDATE
}

enum PermissionModule {
  WORK_PERMITS
  SAFETY_ANALYTICS
  ACCESS_CONTROL
  ASSET_REGISTRY
}

enum AssetStatus {
  OPERATIONAL
  MAINTENANCE
  DECOMMISSIONED
}

// Physical infrastructure a permit might affect — pumps, valves,
// pipeline segments, etc. Deliberately not linked to Permit yet (no
// permitId FK) to keep this addition scoped; the natural next step is
// letting a permit reference which asset(s) it affects, but that's a
// bigger change (wizard step, validation, etc.) than "give
// ASSET_REGISTRY permissions something real to gate."
model Asset {
  id        String      @id @default(cuid())
  name      String
  assetTag  String      @unique
  category  String
  location  String
  status    AssetStatus @default(OPERATIONAL)
  notes     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([status])
}
